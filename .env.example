NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase CLI (link, db reset, gen types) and `npm run test:db`
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Optional: full Postgres URL for `npm run test:db`; overrides the linked pooler URL + SUPABASE_DB_PASSWORD
SUPABASE_DB_URL=

# Interactive map basemap (MapLibre style JSON), e.g. MapTiler with a key restricted to your domains:
# https://api.maptiler.com/maps/streets-v2/style.json?key=<key>
# Unset: MapLibre demo style in development; list view only in production.
NEXT_PUBLIC_MAP_STYLE_URL=

# FX ingestion (spec §10). EXCHANGERATE_HOST_KEY: primary provider; empty -> the keyless Frankfurter backup is used.
# CRON_SECRET: Vercel Cron sends it as "Authorization: Bearer"; cron routes return 401 when it is unset or empty.
EXCHANGERATE_HOST_KEY=
CRON_SECRET=

# Public origin for sitemaps, canonicals, hreflang and JSON-LD (no trailing slash). Required for production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
