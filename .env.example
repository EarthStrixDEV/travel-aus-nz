NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase CLI (link, db reset, gen types) and `npm run test:db`
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Optional: full Postgres URL for `npm run test:db`; overrides the linked pooler URL + SUPABASE_DB_PASSWORD
SUPABASE_DB_URL=

# Interactive map basemap (MapLibre style JSON). MapTiler: replace YOUR_MAPTILER_KEY with a key
# restricted to your domains. Unset: MapLibre demo style in development; list view only in production.
NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY
